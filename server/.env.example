# Server environment configuration.
# Copy this file to server/.env and fill in real values for your machine.
# server/.env is gitignored - never commit real secrets.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/glacier_tasks
# Set to true for managed databases that require TLS (Cloud SQL, etc).
DATABASE_SSL=false

# Long random string used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_NAME=glacier.sid
# Session lifetime in milliseconds (24 hours).
SESSION_MAX_AGE_MS=86400000
# 'lax' for same-site deployments, 'none' (with HTTPS) for cross-site deployments.
SESSION_SAME_SITE=lax

# Exact origin of the frontend. Used for CORS and the CSRF origin check.
CLIENT_ORIGIN=http://localhost:5173

# Comma-separated list of extra allowed origins, if the frontend is served
# from more than one domain.
# EXTRA_ALLOWED_ORIGINS=https://another-domain.example
